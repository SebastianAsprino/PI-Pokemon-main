# Cadena de conexión de PostgreSQL
DATABASE=postgres://usuario:password@localhost:5432/pokemon

# SSL hacia la DB: dejalo en true para bases en la nube, false para Postgres local
DB_SSL=false
# Verificar el certificado del servidor (recomendado true si tu proveedor lo soporta)
DB_SSL_REJECT_UNAUTHORIZED=false

# Puerto HTTP de la API
PORT=8080

# Orígenes permitidos por CORS, separados por coma (vacío = cualquiera)
CORS_ORIGIN=http://localhost:5173
